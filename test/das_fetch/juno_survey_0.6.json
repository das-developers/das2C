    "name": "Resolution",
    "required": false,
    "title": "Maximum resolution between output time points",
    "type": "real",
    "units": "s"
   },
   "start_time": {
    "name": "Min Time",
    "required": true,
    "title": "Minimum time value to stream",
    "type": "isotime"
   }
