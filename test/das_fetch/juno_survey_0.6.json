{
 "format": {
  "default": {
   "mime": "application/vnd.das2.das2stream",
   "name": "Das2 Stream"
  }
 },
 "interface": {
  "coordinates": {
   "frequency": {
    "name": "Frequency",
    "title": "Y",
    "units": {
     "value": "Hz"
    }
   },
   "time": {
    "maximum": {
     "set": {
      "param": "end_time",
      "range": [
       "2010-09-01T00:00:00",
       "now"
      ],
      "required": true
     },
     "value": "2018-10-04T11:00"
    },
    "minimum": {
     "set": {
      "param": "start_time",
      "range": [
       "2010-09-01T00:00:00",
       "now"
      ],
      "required": true
     },
     "value": "2018-10-02T11:00"
    },
    "name": "Time",
    "resolution": {
     "set": {
      "param": "resolution",
      "required": false
     },
     "units": "s",
     "value": 86.4
    },
    "units": {
     "value": "UTC"
    }
   }
  },
  "data": {
   "specdens": {
    "name": "Specdens",
    "title": "Z",
    "units": {
     "value": "V**2 m**-2 Hz**-1"
    }
   }
  },
  "options": {
   "ascii": {
    "set": {
     "flag": "00",
     "param": "params",
     "value": true
    },
    "title": "If specified, output is in UTF-8 format",
    "type": "boolean",
    "value": false
   },
   "b": {
    "set": {
     "flag": "03",
     "param": "params",
     "value": true
    },
    "title": "Only output magnetic data from the low-band of the Low Frequency Receiver",
    "type": "boolean",
    "value": false
   },
   "das2_text": {
    "name": "das2 text",
    "set": {
     "param": "ascii",
     "pval": "true",
     "value": true
    },
    "title": "Convert stream to das2 text (utf-8) format",
    "value": false
   },
   "hfrh": {
    "set": {
     "flag": "07",
     "param": "params",
     "value": true
    },
    "title": "Only output data from the frequency down-mixed sections of the High Frequency Receivers",
    "type": "boolean",
    "value": false
   },
   "hfrl": {
    "set": {
     "flag": "06",
     "param": "params",
     "value": true
    },
    "title": "Only output data from the baseband of the High Frequency Receivers",
    "type": "boolean",
    "value": false
   },
   "keep-spikes": {
    "set": {
     "flag": "01",
     "param": "params",
     "value": true
    },
    "title": "If specified single LFR packets with a pre-amp toggle are retained in the output",
    "type": "boolean",
    "value": false
   },
   "lfrh": {
    "set": {
     "flag": "05",
     "param": "params",
     "value": true
    },
    "title": "Only output data from the high-band of the Low Frequency Receiver",
    "type": "boolean",
    "value": false
   },
   "lfrl": {
    "set": {
     "flag": "04",
     "param": "params",
     "value": true
    },
    "title": "Only output electric from the low-band of the Low Frequency Receiver",
    "type": "boolean",
    "value": false
   },
   "xmas": {
    "set": {
     "flag": "02",
     "param": "params",
     "value": true
    },
    "title": "If specified only output the Xmas flag",
    "type": "boolean",
    "value": false
   }
  }
 },
 "name": "Das2/2.2 Source",
